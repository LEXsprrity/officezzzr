{
  "name": "StealASeed",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared",
        "IconIds": { "$path": "icons/ids.json" },
        "MonetizationIds": { "$path": "monetization/ids.json" }
      }
    },
    "ServerStorage": {
      "Assets": { "$path": "assets" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "World": { "$path": "map/World.rbxm" },
      "$properties": {
        "StreamingEnabled": false,
        "RejectCharacterDeletions": "Enabled"
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Neutral": true,
          "Size": [12, 1, 12],
          "Position": [20, 0.5, 0],
          "Duration": 0,
          "Transparency": 1,
          "CanCollide": false,
          "CanTouch": false,
          "CanQuery": false,
          "CastShadow": false
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "ClockTime": 14,
        "GeographicLatitude": 30,
        "Brightness": 2,
        "Ambient": [0.275, 0.282, 0.322],
        "OutdoorAmbient": [0.502, 0.51, 0.541],
        "ColorShift_Top": [0.925, 0.894, 0.831],
        "ColorShift_Bottom": [0.157, 0.216, 0.314],
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 0.1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.1,
        "ExposureCompensation": -0.1
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 3000,
          "SunAngularSize": 14,
          "MoonAngularSize": 14,
          "CelestialBodiesShown": true
        }
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0,
          "Offset": 0.25,
          "Color": [0.784, 0.894, 1.0],
          "Decay": [0.431, 0.627, 0.863],
          "Glare": 0,
          "Haze": 0
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.15,
          "Size": 20,
          "Threshold": 2.5
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.12,
          "Contrast": 0.04,
          "Brightness": 0,
          "TintColor": [1.0, 1.0, 1.0]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.02,
          "Spread": 0.6
        }
      }
    }
  }
}
